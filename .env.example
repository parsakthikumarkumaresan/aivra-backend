# Copy to .env for local development. Never commit the real .env file.
# See app/core/config.py for the full typed settings this maps to.

# --- Application ---
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aivra:aivra@localhost:5433/aivra
DATABASE_ECHO=false

# --- Redis / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / sessions ---
JWT_SECRET_KEY=change-me-to-a-long-random-value-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Object storage (S3-compatible; MinIO locally) ---
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET_DOCUMENTS=aivra-documents
OBJECT_STORAGE_BUCKET_RECORDINGS=aivra-recordings
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# --- AI providers ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- HR AI voice screening (LiveKit + SIP) — independently scoped from the
# separate Voice bounded context's LIVEKIT_*/TWILIO_* settings below.
HR_SCREENING_PHONE_NUMBER=
HR_SIP_TRUNK_ID=
HR_LIVEKIT_URL=
HR_LIVEKIT_API_KEY=
HR_LIVEKIT_API_SECRET=

# --- STT / TTS ---
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=

# --- Telephony ---
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SIGNING_SECRET=

# --- Payments ---
PAYMENT_PROVIDER=razorpay
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Calendar ---
CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Email / SMS ---
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@aivra.ai
SMS_PROVIDER=twilio

# --- Observability ---
OTEL_EXPORTER_ENDPOINT=
SENTRY_DSN=
